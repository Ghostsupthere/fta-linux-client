// Realmgate launcher UI. Portal theme (dusk-purple stone, the portal's green for actions, torch-fire amber for
// headings), a frameless rounded window and a frosted panel over a day or night background picture. Data and
// actions come from the Rust side.

import "../assets/fonts/CinzelBold.ttf";
import "../assets/fonts/CinzelBlack.ttf";
import "../assets/fonts/CinzelDecorative-Bold.ttf";

export global Pal {
    // Day (dusk purple) or night (midnight blue); the Rust side sets it from the saved choice or the clock, and the
    // toggle in the header flips it.
    in-out property <bool> night: false;
    // Fonts: engraved capitals for headings and buttons, a flourished one for the name.
    out property <string> font-head: "Cinzel Bold";
    out property <string> font-black: "Cinzel Black";
    out property <string> font-title: "Cinzel Decorative";
    // Torch-fire amber: headings, bullets and links.
    out property <color> gold: #ffb347;
    out property <color> gold-hi: #ffd391;
    out property <color> gold-lo: #e0881c;
    out property <color> on-gold: #1f1005;
    // The portal's green: actions, the active tab, focus and progress.
    out property <color> portal: #8dff3c;
    out property <color> portal-hi: #bfff85;
    out property <color> portal-lo: #4fbf1c;
    out property <color> on-portal: #06140a;
    out property <color> text: night ? #eef2ff : #f5f1ff;
    out property <color> text-dim: night ? #c4d0f0b8 : #d6cbf0b8;
    out property <color> glass: night ? #0b123678 : #1a0f3a70;
    // Window ground, header buttons and the stone-coloured secondary buttons.
    out property <color> base: night ? #070a1c : #0d0820;
    out property <color> chrome: night ? #0a1030b8 : #150c2eb8;
    out property <color> stone: night ? #1a2650a0 : #2c1d4fa0;
    out property <color> stone-hi: night ? #2a3a78d8 : #44327ad8;
    out property <color> stone-press: night ? #3a4c90d0 : #5a4694d0;
    out property <color> rim: night ? #9db8ff48 : #c8b6ff48;
    out property <color> bubble: night ? #16204a : #2a1d4a;
    out property <color> line: #ffffff2a;
    out property <color> warn: #ffd98a;
}

export struct CheckRow {
    // 0 fine, 1 worth a look, 2 a problem
    level: int,
    name: string,
    detail: string,
}

export struct ChangeRow {
    // 0 release heading, 1 lead-in, 2 paragraph, 3 bullet
    kind: int,
    text: string,
    sub: string,
}

export struct SettingRow {
    key: string,
    label: string,
    hint: string,
    // Non-empty on the first row of a category: the heading drawn above it.
    header: string,
    checked: bool,
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 34px;
    border-radius: 17px;
    background: active ? @linear-gradient(180deg, Pal.portal-hi 0%, Pal.portal-lo 100%) : (ta.has-hover ? #8dff3c26 : transparent);
    animate background { duration: 140ms; }
    Text {
        text: root.label;
        color: root.active ? Pal.on-portal : Pal.text;
        font-size: 15px;
        font-family: Pal.font-head;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Portal button. The primary one is a pool of swirling portal energy (two counter-turning layers of the same
// vortex under the label); the secondary one is dark stone that lights up green when hovered.
component GlassButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: true;
    in property <bool> enabled: true;
    // The label fills the button: tall primary buttons (Play) pass a big size.
    in property <length> text-size: primary ? 22px : 17px;
    callback clicked;
    height: 52px;
    border-radius: self.height / 2;
    opacity: enabled ? 1.0 : 0.45;
    drop-shadow-blur: primary && enabled ? (ta.has-hover ? 28px : 16px) : 0px;
    drop-shadow-color: primary && enabled ? #8dff3c80 : transparent;
    drop-shadow-offset-y: 3px;
    animate drop-shadow-blur { duration: 220ms; }

    body := Rectangle {
        border-radius: parent.border-radius;
        clip: true;
        background: primary ? #0a2a10 : (ta.pressed ? Pal.stone-press : (ta.has-hover ? Pal.stone-hi : Pal.stone));
        animate background { duration: 140ms; }
        if root.primary : Image {
            source: @image-url("../assets/swirl.png");
            width: max(root.width, 220px) * 1.5;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            rotation-angle: root.enabled ? 360deg * animation-tick() / 18s : 0deg;
            opacity: ta.pressed ? 0.55 : (ta.has-hover ? 1.0 : 0.82);
            animate opacity { duration: 200ms; }
        }
        if root.primary : Image {
            source: @image-url("../assets/swirl.png");
            width: max(root.width, 220px) * 1.1;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            rotation-angle: root.enabled ? -360deg * animation-tick() / 11s : 0deg;
            opacity: ta.has-hover ? 0.55 : 0.38;
            animate opacity { duration: 200ms; }
        }
        // keeps the label readable over the bright swirl
        if root.primary : Rectangle {
            background: @linear-gradient(90deg, #00000090 0%, #00000030 38%, #00000030 62%, #00000090 100%);
        }
        Rectangle {
            border-radius: parent.border-radius;
            border-width: primary ? 1.5px : 1px;
            border-color: primary ? (ta.has-hover ? Pal.portal-hi : #bfff85a0) : (ta.has-hover ? Pal.portal-lo : Pal.rim);
            animate border-color { duration: 140ms; }
        }
    }
    Text {
        text: root.label;
        color: root.primary ? #f4ffe8 : Pal.text;
        font-size: root.text-size;
        font-family: root.primary ? Pal.font-black : Pal.font-head;
        font-weight: 800;
        letter-spacing: root.primary ? 3px : 1px;
        // A dark outline keeps the label crisp over the bright swirl.
        stroke: root.primary ? #031208 : transparent;
        stroke-width: root.primary ? max(1.5px, root.text-size / 19) : 0px;
        stroke-style: outside;
        horizontal-alignment: center;
        vertical-alignment: center;
        // the label sits outside the clipped body: drawn inside the clip it shimmered as the swirl turned
        width: parent.width; height: parent.height;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component PresetPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;
    height: 30px;
    width: t.preferred-width + 28px;
    border-radius: 15px;
    background: active ? #8dff3c38 : (ta.pressed ? #8dff3c45 : (ta.has-hover ? #8dff3c26 : #ffffff14));
    border-width: 1px;
    border-color: active ? Pal.portal : (ta.has-hover ? Pal.portal-lo : Pal.line);
    animate background, border-color { duration: 120ms; }
    t := Text { text: root.label; color: Pal.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Controlled checkbox: it shows `checked` and reports clicks; the owner flips the value.
component Check inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <string> hint;
    callback toggled;
    height: 48px;
    border-radius: 12px;
    background: ta.has-hover ? #ffffff14 : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        alignment: start;
        Rectangle {
            width: 22px;
            height: 22px;
            y: (root.height - 22px) / 2;
            border-radius: 7px;
            border-width: 2px;
            border-color: root.checked ? Pal.portal : #ffffff88;
            background: root.checked ? Pal.portal : transparent;
            animate background, border-color { duration: 140ms; }
            Text {
                text: "✓";
                visible: root.checked;
                color: Pal.on-portal;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.label; color: Pal.text; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.hint; color: Pal.text-dim; font-size: 11px; overflow: elide; visible: root.hint != ""; }
        }
    }
    ta := TouchArea { clicked => { root.toggled(); } }
}

component Section inherits Text {
    font-family: Pal.font-head;
    color: Pal.gold;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> invalid: false;
    callback edited(string);
    height: 44px;
    border-radius: 12px;
    background: #00000045;
    border-width: 1px;
    border-color: root.invalid ? #ff8a80 : (input.has-focus ? Pal.portal : Pal.line);
    animate border-color { duration: 120ms; }
    Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.placeholder;
        visible: root.text == "";
        color: Pal.text-dim;
        font-size: 15px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text <=> root.text;
        color: Pal.text;
        font-size: 15px;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: #6fe02a80;
        selection-foreground-color: #ffffff;
        edited => { root.edited(self.text); }
    }
}

// Status text on the left, Reset and Apply on the right; shared by the Game and Settings pages.
component ApplyBar inherits HorizontalLayout {
    in property <string> message;
    in property <bool> dirty;
    in property <bool> blocked;
    in property <bool> can-apply: true;
    callback reset;
    callback apply;
    spacing: 12px;
    alignment: end;
    Text {
        text: root.message;
        color: root.dirty ? Pal.warn : Pal.text-dim;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    GlassButton { width: 130px; height: 44px; primary: false; label: "Reset"; enabled: root.dirty; clicked => { root.reset(); } }
    GlassButton { width: 150px; height: 44px; text-size: 23px; label: "APPLY"; enabled: root.dirty && !root.blocked && root.can-apply; clicked => { root.apply(); } }
}

component StatusDot inherits Rectangle {
    in property <int> level;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background: level == 0 ? #5ad18a : (level == 1 ? #ffd98a : #ff6b6b);
}

// A thin carved divider: an amber line that fades out at both ends with a diamond in the middle.
component Ornament inherits Rectangle {
    height: 16px;
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        Rectangle { width: 120px; height: 1px; y: 8px; background: @linear-gradient(90deg, #ffb34700 0%, #ffb347c0 100%); }
        Path { width: 14px; height: 14px; y: 1px; viewbox-width: 14; viewbox-height: 14; commands: "M 7 0 L 14 7 L 7 14 L 0 7 Z"; fill: Pal.gold; }
        Rectangle { width: 120px; height: 1px; y: 8px; background: @linear-gradient(90deg, #ffb347c0 0%, #ffb34700 100%); }
    }
}

export component MainWindow inherits Window {
    // Frameless window with a transparent corner area; needs a compositing window manager.
    no-frame: true;
    background: transparent;
    width: 1000px;
    height: 640px;
    title: "Realmgate";
    // The taskbar icon (X11 window icon); the portal artwork is used inside the launcher.
    icon: @image-url("../assets/taskbar.png");

    // 0 Play, 1 Game, 2 Settings, 3 Diagnostics
    in-out property <int> tab: 0;

    // Play page
    in property <string> headline: "Ready to play";
    in property <string> subline;
    in property <bool> client-found: true;
    // What the sentinel on the Play page is saying; clicking it asks for another line.
    in property <string> quip;
    callback new-quip;
    callback play;

    // Updates. 0 nothing to show, 1 checking, 2 available, 3 asking for confirmation, 4 working, 5 failed
    in property <int> update-state: 0;
    in property <string> update-text;
    // After a failed update: the release is still known, so the button can try again.
    in property <bool> update-retry: false;
    in property <string> update-notes;
    in property <string> update-title;
    in property <float> update-progress: 0;
    in property <[ChangeRow]> changelog;
    in property <string> changelog-status;
    callback check-update;
    callback ask-update;
    callback cancel-ask;
    callback start-update;

    // Game page
    in-out property <string> game-realm;
    in-out property <string> game-resolution;
    in property <bool> game-windowed;
    in property <bool> game-vsync;
    in property <int> game-msaa: 1;
    in property <[string]> resolution-presets;
    in property <[int]> msaa-choices;
    in property <string> game-problem;
    in property <bool> game-realm-bad;
    in property <bool> game-resolution-bad;
    in property <bool> game-dirty;
    in property <string> game-status;
    callback game-realm-edited(string);
    callback game-resolution-edited(string);
    callback game-pick-resolution(string);
    callback game-toggle-windowed;
    callback game-toggle-vsync;
    callback game-set-msaa(int);
    callback apply-game;
    callback reset-game;

    // Settings page
    in-out property <[SettingRow]> settings;
    in property <[string]> preset-names;
    in-out property <bool> dirty: false;
    in-out property <string> status: "";
    in property <bool> game-running: false;
    callback toggle-setting(int);
    callback apply-settings;
    callback reload-settings;
    callback load-preset(int);

    // Diagnostics page
    in property <[CheckRow]> checks;
    in property <string> report-text;
    in property <bool> diag-busy: false;
    in property <string> diag-status;
    callback run-diagnostics;
    callback save-report;
    callback report-copied;

    public function copy-report() {
        report-input.select-all();
        report-input.copy();
        report-input.clear-selection();
        root.report-copied();
    }

    // Window
    callback close-requested;
    callback minimize-requested;
    callback toggle-theme;
    // Starts moving the window; the position is where the pointer went down.
    callback drag-window(float, float);
    // Opens one of the launcher's fixed links in the user's browser (the Rust side checks the URL).
    callback open-link(string);

    // Holds the report so the Copy button can use the system clipboard; one transparent pixel, never seen.
    report-input := TextInput { x: 0px; y: 0px; width: 1px; height: 1px; text: root.report-text; read-only: true; color: transparent; wrap: no-wrap; }

    // The content sits 5 px inside the window; the stone frame (below) covers the edge and the gap.
    shell := Rectangle {
        x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 10px;
        border-radius: 16px;
        clip: true;
        background: Pal.base;

        Image {
            source: Pal.night ? @image-url("../assets/bg-night.jpg") : @image-url("../assets/bg-day.jpg");
            width: parent.width;
            height: parent.height;
            image-fit: cover;
        }
        // soft vignette so text stays readable
        Rectangle { background: @linear-gradient(180deg, #00000030 0%, #00000000 30%, #0000004a 100%); }

        // ---- header (drag area, logo, window buttons) ----
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 84px;
            TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { root.drag-window(self.mouse-x / 1px, self.mouse-y / 1px); } } }
            HorizontalLayout {
                padding-left: 34px; padding-right: 20px; padding-top: 22px; padding-bottom: 12px;
                spacing: 14px;
                // Room for the logo, which is drawn larger than the layout row (see the Image after this layout).
                Rectangle { width: 102px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text { text: "REALMGATE"; color: Pal.text; font-family: Pal.font-title; font-size: 30px; font-weight: 800; letter-spacing: 3px; stroke: #12072b; stroke-width: 3px; stroke-style: outside; }
                    Text { text: "A Linux client reforged for modern systems."; color: Pal.text-dim; font-size: 12px; font-weight: 600; }
                    Rectangle {
                        height: 14px;
                        HorizontalLayout {
                            alignment: start;
                            Text {
                                text: "BY @GHOSTSUPTHERE";
                                color: credit-ta.has-hover ? Pal.gold-hi : Pal.gold;
                                font-size: 10px; font-weight: 700; letter-spacing: 4px;
                                vertical-alignment: center;
                                credit-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-link("https://github.com/Ghostsupthere"); } }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    // Day / night switch: the highlighted disc slides under the sun or the moon.
                    Rectangle {
                        width: 66px; height: 32px; border-radius: 16px;
                        background: Pal.chrome;
                        border-width: 1px;
                        border-color: theme-ta.has-hover ? Pal.portal-lo : #ffffff26;
                        animate border-color { duration: 120ms; }
                        Rectangle {
                            y: 3px; width: 26px; height: 26px; border-radius: 13px;
                            x: Pal.night ? 37px : 3px;
                            background: Pal.night ? #7d9bff55 : #ffb34770;
                            animate x { duration: 220ms; easing: ease-in-out; }
                        }
                        Image { source: @image-url("../assets/sun.png"); x: 6px; y: 6px; width: 20px; height: 20px; opacity: Pal.night ? 0.5 : 1.0; animate opacity { duration: 200ms; } }
                        Image { source: @image-url("../assets/moon.png"); x: 40px; y: 6px; width: 20px; height: 20px; opacity: Pal.night ? 1.0 : 0.5; animate opacity { duration: 200ms; } }
                        theme-ta := TouchArea { clicked => { root.toggle-theme(); } }
                    }
                    Rectangle {
                        width: 78px; height: 32px; border-radius: 16px;
                        background: wiki-ta.has-hover ? Pal.gold : Pal.chrome;
                        animate background { duration: 120ms; }
                        Text { text: "Wiki ↗"; color: wiki-ta.has-hover ? Pal.on-gold : Pal.text; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        wiki-ta := TouchArea { clicked => { root.open-link("https://wiki.downloadautism.com/"); } }
                    }
                    Rectangle {
                        width: 32px; height: 32px; border-radius: 16px;
                        background: min-ta.has-hover ? #ffffff44 : Pal.chrome;
                        Text { text: "–"; color: Pal.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                        min-ta := TouchArea { clicked => { root.minimize-requested(); } }
                    }
                    Rectangle {
                        width: 32px; height: 32px; border-radius: 16px;
                        background: close-ta.has-hover ? #e5484d : Pal.chrome;
                        animate background { duration: 120ms; }
                        Text { text: "✕"; color: Pal.text; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                        close-ta := TouchArea { clicked => { root.close-requested(); } }
                    }
                }
            }
        }

        // ---- frosted glass panel ----
        panel := Rectangle {
            x: 40px; y: 96px;
            width: parent.width - 80px;
            height: parent.height - 96px - 40px;
            border-radius: 22px;
            clip: true;
            // Same picture, pre-blurred, aligned with the sharp one so it reads as frosted glass.
            Image {
                source: Pal.night ? @image-url("../assets/bg-night-blur.jpg") : @image-url("../assets/bg-day-blur.jpg");
                x: -panel.x; y: -panel.y;
                width: shell.width; height: shell.height;
                image-fit: cover;
            }
            Rectangle { background: Pal.glass; }
            Rectangle {
                border-radius: 22px;
                border-width: 1px;
                border-color: Pal.line;
            }

            VerticalLayout {
                padding: 26px;
                padding-bottom: 22px;
                spacing: 16px;

                // pill tabs (moved down a little to clear the logo's glow)
                HorizontalLayout {
                    alignment: start;
                    padding-top: 12px;
                    Rectangle {
                        background: #ffffff14; border-radius: 21px; width: 440px; height: 42px;
                        HorizontalLayout {
                            padding: 4px; spacing: 4px;
                            TabButton { label: "Play"; active: root.tab == 0; clicked => { root.tab = 0; } }
                            TabButton { label: "Game"; active: root.tab == 1; clicked => { root.tab = 1; } }
                            TabButton { label: "Settings"; active: root.tab == 2; clicked => { root.tab = 2; } }
                            TabButton { label: "Diagnostics"; active: root.tab == 3; clicked => { root.tab = 3; } }
                        }
                    }
                }

                // ---- Play page ----
                if root.tab == 0 : Rectangle {
                  vertical-stretch: 1;
                  HorizontalLayout {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    spacing: 30px;
                    VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 14px;
                    Rectangle { vertical-stretch: 1; }
                    // The headline and its explanation only appear when something is wrong (no client folder).
                    if !root.client-found : Text {
                        text: root.headline;
                        color: Pal.text;
                        font-size: 30px;
                        font-family: Pal.font-head;
                        font-weight: 800;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    if !root.client-found : Text { text: root.subline; color: Pal.text-dim; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                    Rectangle { height: 6px; }

                    // asking for confirmation before anything is installed
                    if root.update-state == 3 : Rectangle {
                        height: 200px;
                        border-radius: 16px;
                        background: #ffffff16;
                        border-width: 1px;
                        border-color: Pal.line;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: root.update-title; color: Pal.gold; font-family: Pal.font-head; font-size: 18px; font-weight: 800; }
                            Text { text: root.update-notes; color: Pal.text; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; overflow: elide; }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                GlassButton { width: 180px; height: 42px; text-size: 19px; label: "UPDATE NOW"; clicked => { root.start-update(); } }
                                GlassButton { width: 120px; height: 40px; primary: false; label: "Not now"; clicked => { root.cancel-ask(); } }
                            }
                        }
                    }

                    // progress while downloading and installing
                    if root.update-state == 4 : VerticalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 10px;
                            border-radius: 5px;
                            background: #ffffff22;
                            clip: true;
                            Rectangle {
                                x: 0; width: parent.width * max(0.04, min(1.0, root.update-progress)); height: parent.height;
                                border-radius: 5px;
                                background: @linear-gradient(90deg, Pal.portal-lo 0%, Pal.portal-hi 100%);
                                animate width { duration: 160ms; }
                            }
                        }
                        Text { text: root.update-text; color: Pal.text-dim; font-size: 13px; overflow: elide; }
                    }

                    if root.client-found && root.update-state != 3 && root.update-state != 4 : Text {
                        text: (root.update-state == 2 || (root.update-state == 5 && root.update-retry)) ? "AN UPDATE AWAITS" : "THE PORTAL IS OPEN";
                        color: Pal.gold;
                        font-family: Pal.font-head;
                        font-size: 15px;
                        letter-spacing: 5px;
                        horizontal-alignment: center;
                    }
                    if root.client-found && root.update-state != 3 && root.update-state != 4 : Ornament { }
                    if root.update-state != 3 && root.update-state != 4 : HorizontalLayout {
                        alignment: center;
                        spacing: 14px;
                        GlassButton {
                            width: 270px;
                            height: 68px;
                            text-size: root.update-state == 2 ? 38px : (root.update-state == 5 && root.update-retry ? 29px : 44px);
                            label: root.update-state == 2 ? "UPDATE" : (root.update-state == 5 && root.update-retry ? "TRY AGAIN" : "PLAY");
                            enabled: root.client-found && !root.game-running;
                            clicked => { if (root.update-state == 2 || (root.update-state == 5 && root.update-retry)) { root.ask-update(); } else { root.play(); } }
                        }
                        if root.update-state == 2 || (root.update-state == 5 && root.update-retry) : GlassButton {
                            width: 150px;
                            primary: false;
                            label: "Play anyway";
                            enabled: root.client-found && !root.game-running;
                            clicked => { root.play(); }
                        }
                    }

                    if root.game-running || root.update-state == 5 : Text {
                        text: root.game-running ? "The game is running." : root.update-text;
                        color: Pal.warn;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    if root.client-found && root.update-state != 3 && root.update-state != 4 : Ornament { }
                    if root.client-found && root.update-state != 3 && root.update-state != 4 : Text {
                        text: (root.update-state == 2 || (root.update-state == 5 && root.update-retry)) ? "Update first, or play anyway." : "Step through when you are ready.";
                        color: Pal.text-dim;
                        font-size: 13px;
                        font-italic: true;
                        horizontal-alignment: center;
                    }
                    Rectangle { vertical-stretch: 1; }

                    // The sentinel from the taskbar icon, with something to say. Click it for another line.
                    if root.update-state != 3 && root.update-state != 4 && root.quip != "" : HorizontalLayout {
                        height: 92px;
                        alignment: start;
                        spacing: 0px;
                        Rectangle {
                            width: 92px;
                            Image {
                                source: @image-url("../assets/taskbar.png");
                                width: 80px; height: 80px;
                                x: 6px;
                                y: 6px + 2px * sin(360deg * animation-tick() / 3.2s) - (sentinel-ta.has-hover ? 3px : 0px);
                                image-fit: contain;
                                animate y { duration: 140ms; }
                            }
                            sentinel-ta := TouchArea { mouse-cursor: pointer; clicked => { root.new-quip(); } }
                        }
                        Path {
                            width: 12px; height: 92px;
                            viewbox-width: 12; viewbox-height: 92;
                            commands: "M 12 38 L 0 46 L 12 54 Z";
                            fill: Pal.bubble;
                        }
                        Rectangle {
                            width: 340px;
                            border-radius: 14px;
                            background: Pal.bubble;
                            border-width: 1px;
                            border-color: Pal.rim;
                            Text {
                                x: 16px; y: 0px;
                                width: parent.width - 32px; height: parent.height;
                                text: root.quip;
                                color: Pal.text;
                                font-size: 14px;
                                font-italic: true;
                                wrap: word-wrap;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { height: 4px; }

                    // Status line at the very bottom: the version situation, and a way to check again.
                    HorizontalLayout {
                        alignment: start;
                        spacing: 14px;
                        if root.update-state != 3 && root.update-state != 4 && root.update-state != 5 && root.update-text != "" : Text {
                            text: root.update-text;
                            color: Pal.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        if root.update-state == 5 || root.update-state == 0 : Text {
                            text: "Check for updates";
                            color: chk-ta.has-hover ? Pal.gold-hi : Pal.text-dim;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                            chk-ta := TouchArea { clicked => { root.check-update(); } }
                        }
                    }
                    }

                    // ---- changelog (right) ----
                    Rectangle {
                        width: 400px;
                        border-radius: 16px;
                        background: #00000030;
                        border-width: 1px;
                        border-color: Pal.line;
                        clip: true;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 8px;
                            Section { text: "WHAT'S NEW"; height: 30px; font-size: 19px; letter-spacing: 2px; }
                            if root.changelog-status != "" : Text {
                                text: root.changelog-status;
                                color: Pal.text-dim;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            log-area := Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                log-flick := Flickable {
                                    content-width: parent.width;
                                    content-height: log-list.preferred-height;
                                    log-list := VerticalLayout {
                                        spacing: 5px;
                                        padding-right: 12px;
                                        for row in root.changelog : VerticalLayout {
                                            spacing: 1px;
                                            if row.kind == 0 : VerticalLayout {
                                                padding-top: 10px;
                                                spacing: 1px;
                                                Text { text: row.text; color: Pal.gold; font-family: Pal.font-head; font-size: 18px; font-weight: 800; }
                                                Text { text: row.sub; color: Pal.text-dim; font-size: 11px; wrap: word-wrap; }
                                            }
                                            if row.kind == 1 : Text { text: row.text; color: Pal.text; font-size: 13px; font-weight: 700; wrap: word-wrap; }
                                            if row.kind == 2 : Text { text: row.text; color: Pal.text-dim; font-size: 12px; wrap: word-wrap; }
                                            if row.kind == 3 : HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 8px;
                                                Text { text: "•"; color: Pal.gold; font-size: 12px; vertical-alignment: top; }
                                                Text { text: row.text; color: Pal.text-dim; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
                                            }
                                        }
                                    }
                                }
                                if log-flick.content-height > log-flick.height : Rectangle {
                                    x: parent.width - 5px;
                                    width: 4px;
                                    border-radius: 2px;
                                    background: #ffffff55;
                                    height: max(36px, log-flick.height * log-flick.height / log-flick.content-height);
                                    y: -log-flick.content-y / (log-flick.content-height - log-flick.height) * (log-flick.height - self.height);
                                }
                            }
                        }
                    }
                }
                }

                // ---- Game page ----
                if root.tab == 1 : VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 34px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: start;
                            Section { text: "SERVER"; height: 24px; vertical-alignment: bottom; }
                            Text { text: "Realm address"; color: Pal.text; font-size: 14px; font-weight: 600; }
                            Field {
                                text <=> root.game-realm;
                                placeholder: "for example 192.168.1.5 or play.example.org";
                                invalid: root.game-realm-bad;
                                edited(t) => { root.game-realm-edited(t); }
                            }
                            Text { text: "Written to realmlist.wtf and Config.wtf together."; color: Pal.text-dim; font-size: 11px; }
                            Rectangle { height: 8px; }
                            Section { text: "ANTI-ALIASING"; height: 24px; vertical-alignment: bottom; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                for n in root.msaa-choices : PresetPill {
                                    label: n == 1 ? "Off" : n + "x";
                                    active: root.game-msaa == n;
                                    clicked => { root.game-set-msaa(n); }
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            alignment: start;
                            Section { text: "DISPLAY"; height: 24px; vertical-alignment: bottom; }
                            Check { label: "Windowed"; hint: "Off runs the game fullscreen"; checked: root.game-windowed; toggled => { root.game-toggle-windowed(); } }
                            Check { label: "Vertical sync"; hint: "Stops tearing; may add input lag"; checked: root.game-vsync; toggled => { root.game-toggle-vsync(); } }
                            Rectangle { height: 6px; }
                            Text { text: "Resolution"; color: Pal.text; font-size: 14px; font-weight: 600; x: 12px; }
                            Field {
                                text <=> root.game-resolution;
                                placeholder: "width x height, like 1920x1080";
                                invalid: root.game-resolution-bad;
                                edited(t) => { root.game-resolution-edited(t); }
                            }
                            Rectangle { height: 2px; }
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                for r in root.resolution-presets : PresetPill {
                                    label: r;
                                    active: root.game-resolution == r;
                                    clicked => { root.game-pick-resolution(r); }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if root.game-running : Text { text: "The game is running. Close it to change these."; color: Pal.warn; font-size: 13px; }
                    ApplyBar {
                        message: root.game-problem != "" ? root.game-problem : (root.game-status != "" ? root.game-status : (root.game-dirty ? "Unsaved changes." : "All saved."));
                        dirty: root.game-dirty || root.game-problem != "";
                        blocked: root.game-running;
                        can-apply: root.game-problem == "";
                        reset => { root.reset-game(); }
                        apply => { root.apply-game(); }
                    }
                }

                // ---- Settings page ----
                if root.tab == 2 : VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "Presets"; color: Pal.text-dim; font-size: 13px; vertical-alignment: center; }
                        for name[i] in root.preset-names : PresetPill { label: name; clicked => { root.load-preset(i); } }
                    }

                    // scrolling list with a thin scroll bar
                    list-area := Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        flick := Flickable {
                            content-width: parent.width;
                            content-height: list.preferred-height;
                            list := VerticalLayout {
                                spacing: 2px;
                                padding-right: 14px;
                                for row[i] in root.settings : VerticalLayout {
                                    if row.header != "" : Section { text: row.header; height: 30px; vertical-alignment: bottom; }
                                    Check { label: row.label; hint: row.hint; checked: row.checked; toggled => { root.toggle-setting(i); } }
                                }
                            }
                        }
                        if flick.content-height > flick.height : Rectangle {
                            x: parent.width - 6px;
                            width: 4px;
                            border-radius: 2px;
                            background: #ffffff55;
                            height: max(36px, flick.height * flick.height / flick.content-height);
                            y: -flick.content-y / (flick.content-height - flick.height) * (flick.height - self.height);
                        }
                    }

                    if root.game-running : Text { text: "The game is running. Close it to change settings."; color: Pal.warn; font-size: 13px; }

                    ApplyBar {
                        message: root.status != "" ? root.status : (root.dirty ? "Unsaved changes." : "All settings saved.");
                        dirty: root.dirty;
                        blocked: root.game-running;
                        reset => { root.reload-settings(); }
                        apply => { root.apply-settings(); }
                    }
                }

                // ---- Diagnostics page ----
                if root.tab == 3 : VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;
                        diag-flick := Flickable {
                            content-width: parent.width;
                            content-height: diag-list.preferred-height;
                            diag-list := VerticalLayout {
                                spacing: 6px;
                                padding-right: 14px;
                                if root.diag-busy : Text { text: "Checking..."; color: Pal.text-dim; font-size: 14px; }
                                for c in root.checks : Rectangle {
                                    height: 48px;
                                    border-radius: 12px;
                                    background: #ffffff10;
                                    HorizontalLayout {
                                        padding-left: 14px; padding-right: 14px; spacing: 12px;
                                        StatusDot { level: c.level; y: (parent.height - self.height) / 2; }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            Text { text: c.name; color: Pal.text; font-size: 13px; font-weight: 700; }
                                            Text { text: c.detail; color: Pal.text-dim; font-size: 12px; overflow: elide; }
                                        }
                                    }
                                }
                            }
                        }
                        if diag-flick.content-height > diag-flick.height : Rectangle {
                            x: parent.width - 6px;
                            width: 4px;
                            border-radius: 2px;
                            background: #ffffff55;
                            height: max(36px, diag-flick.height * diag-flick.height / diag-flick.content-height);
                            y: -diag-flick.content-y / (diag-flick.content-height - diag-flick.height) * (diag-flick.height - self.height);
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;
                        Text { text: root.diag-status; color: Pal.text-dim; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        GlassButton { width: 150px; height: 44px; primary: false; label: "Check again"; enabled: !root.diag-busy; clicked => { root.run-diagnostics(); } }
                        GlassButton { width: 150px; height: 44px; primary: false; label: "Save report"; enabled: !root.diag-busy; clicked => { root.save-report(); } }
                        GlassButton { width: 190px; height: 44px; text-size: 17px; label: "COPY REPORT"; enabled: !root.diag-busy; clicked => { root.copy-report(); } }
                    }
                }
            }
        }
    }

    // ---- aged stone frame: drawn over the edge of the content; its chips are transparent ----
    Image {
        source: Pal.night ? @image-url("../assets/frame-night.png") : @image-url("../assets/frame.png");
        x: 0px; y: 0px; width: parent.width; height: parent.height;
    }

    // ---- crest: overlaps the header and the panel edge; lit with a soft pulsing glow while a client is
    // installed, grey and dark while none is found ----
    if root.client-found : Rectangle {
        x: -3px; y: -11px; width: 160px; height: 160px; border-radius: 80px;
        background: @radial-gradient(circle, #86ff4a58 0%, #86ff4a33 50%, #86ff4a00 76%);
        opacity: 0.8 + 0.2 * sin(360deg * animation-tick() / 4.5s);
    }
    Image {
        source: root.client-found ? @image-url("../assets/icon.png") : @image-url("../assets/icon-dim.png");
        x: 17px; y: 11px; width: 118px; height: 118px;
        image-fit: contain;
    }
}
